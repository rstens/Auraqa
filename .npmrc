# Pin the default registry to npmjs.org so Dependabot doesn't fall back
# to the auto-injected `npm.pkg.github.com` credential. With the
# `automatic-github-packages-auth` experiment enabled, Dependabot bails
# out unless either an .npmrc or a `registries:` block in dependabot.yml
# tells it which scope routes to GitHub Packages — we don't publish or
# consume any @scope/* packages from there, so just pin the default and
# move on.
registry=https://registry.npmjs.org/
