meta {
  name: Get article — boundary (excessively long slug)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/articles/{{bigSlug}}
  body: none
  auth: none
}

script:pre-request {
  // 2000-char slug. Should 4xx cleanly (slug regex rejection or 414), not 500.
  // NOTE: esprima (Bruno's JS parser) doesn't grok ES2021 numeric separators,
  // so `2_000` triggers a parse error — keep the literal plain.
  bru.setVar("bigSlug", "a".repeat(2000));
}

tests {
  test("oversized slug returns 4xx, not 500", function() {
    expect(res.getStatus()).to.be.oneOf([400, 404, 414]);
  });
}
