meta {
  name: Glossary — positive
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/glossary
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is an array of glossary terms", function() {
    const body = res.getBody();
    expect(body).to.be.an("array");
    if (body.length === 0) return;
    expect(body[0]).to.have.property("slug");
    expect(body[0]).to.have.property("term");
  });

  test("ships the documented 90+ terms in dev (best-effort)", function() {
    const body = res.getBody();
    // Not enforced as a hard floor because the API may be paginated; we
    // just confirm the endpoint isn't returning a stub.
    if (Array.isArray(body)) {
      expect(body.length).to.be.greaterThan(10);
    }
  });
}
