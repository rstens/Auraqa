meta {
  name: Login as admin (credentials)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/callback/credentials
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{adminUsername}}
  password: {{adminPassword}}
  csrfToken: {{csrfToken}}
  callbackUrl: {{baseUrl}}/
  json: true
}

tests {
  test("login succeeds (status 200)", function() {
    // NextAuth's callback returns 302 → /, which Bruno's HTTP layer
    // auto-follows. The final response is the rendered home page (200).
    expect(res.getStatus()).to.equal(200);
  });

  test("did not land back on the login page (auth wasn't rejected)", function() {
    // Failed credentials redirect back to /login?error=CredentialsSignin.
    // Successful login redirects to / — res.getUrl() returns the final
    // URL after Bruno follows the redirect chain.
    const finalUrl = String(res.getUrl() || "");
    expect(finalUrl).to.not.match(/\/login(\?|$)/);
  });
}

docs {
  Posts the credentials login. Requires the CSRF cookie set by the
  preceding `Fetch CSRF token` request, plus the `csrfToken` env var
  (csrf.bru stores it via setVar).

  Note: We don't assert on `set-cookie` for the session-token because
  NextAuth issues it on the 302 response and Bruno auto-follows the
  redirect — by the time `res.getHeader('set-cookie')` runs, we're
  looking at the home page response, not the auth callback. The
  cookie IS in Bruno's jar regardless (subsequent requests reuse it
  if any auth-required tests are added in the future).

  res.getUrl() returns the final URL after Bruno follows the redirect
  chain, making it a reliable signal for checking where we landed.
}
