meta {
  name: Search — boundary (10KB query string)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/search?q={{bigQuery}}
  body: none
  auth: none
}

script:pre-request {
  // Build a 10000-char query and substitute into the URL at runtime.
  // NOTE: esprima doesn't grok ES2021 numeric separators (`10_000` errors),
  // so keep the literal plain.
  bru.setVar("bigQuery", "a".repeat(10000));
}

tests {
  test("oversized query is rejected or handled, not 500", function() {
    expect(res.getStatus()).to.be.oneOf([200, 400, 413, 414]);
  });
}
