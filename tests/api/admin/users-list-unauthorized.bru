meta {
  name: Admin users — negative (unauthenticated)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/users
  body: none
  auth: none
}

tests {
  test("anonymous request is rejected", function() {
    expect(res.getStatus()).to.be.oneOf([401, 403]);
  });

  test("user list is not leaked", function() {
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(false);
  });
}
