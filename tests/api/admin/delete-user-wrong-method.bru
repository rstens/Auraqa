meta {
  name: Admin user delete — boundary (wrong method)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/users/00000000-0000-7000-8000-000000000000
  body: none
  auth: none
}

tests {
  test("probe is handled cleanly (no 500)", function() {
    // The /api/admin/users/[id] route does define a GET handler, so this
    // isn't actually a wrong-method probe — it falls through to:
    //   - 401/403 if isAdmin() rejects, OR
    //   - 404 if the all-zeros UUID doesn't exist (admin session in jar).
    // 405 is the answer if the handler is removed in the future.
    expect(res.getStatus()).to.be.oneOf([401, 403, 404, 405]);
  });
}
