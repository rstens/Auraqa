meta {
  name: Update profile — negative (unauthenticated)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/profile
  body: json
  auth: none
}

body:json {
  {
    "username": "anon",
    "bio": "..."
  }
}

tests {
  test("anonymous PUT is rejected (401/403)", function() {
    expect(res.getStatus()).to.be.oneOf([401, 403]);
  });
}
