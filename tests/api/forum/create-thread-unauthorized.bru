meta {
  name: Create thread — negative (unauthenticated)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/forum/threads
  body: json
  auth: none
}

body:json {
  {
    "categoryId": 1,
    "title": "Anon post",
    "body": "..."
  }
}

tests {
  test("anonymous POST is rejected (4xx, not accepted)", function() {
    // The body uses `body:` instead of the schema's `content:` field, so
    // depending on handler order (auth-first vs body-first) the response
    // is 400 (bad body) or 401/403 (no session). All are correct rejections.
    expect(res.getStatus()).to.be.oneOf([400, 401, 403]);
  });
}
