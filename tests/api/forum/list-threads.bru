meta {
  name: List forum threads — positive
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/forum/threads
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is an array", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("each thread carries expected fields", function() {
    const body = res.getBody();
    if (body.length === 0) return;
    const t = body[0];
    expect(t).to.have.property("id");
    expect(t).to.have.property("title");
    expect(t).to.have.property("categoryId");
  });
}
